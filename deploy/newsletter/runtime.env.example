# No secret values belong in this file. Start paused.
MYCHEF_ADDR=127.0.0.1:18473
MYCHEF_DB=/data/mychef.db
MYCHEF_LIFECYCLE_DB=/journal/mychef.lifecycle
MYCHEF_ORIGIN=https://mychef.dev
MYCHEF_NEWSLETTER_ORIGIN=https://mychef.dev
MYCHEF_EMAIL_MODE=resend
MYCHEF_NEWSLETTER_MODE=enabled
MYCHEF_CREDENTIALS=/run/secrets/newsletter.json
MYCHEF_EMAIL_PROOF_KEYS_FILE=/run/secrets/proof-keys.json
MYCHEF_NEWSLETTER_CONSENT_VERSION=REPLACE_WITH_APPROVED_NOTICE_VERSION
MYCHEF_NEWSLETTER_CONTACT=feedback@gkldevelopment.com
MYCHEF_NEWSLETTER_PENDING_DAYS=none
MYCHEF_NEWSLETTER_WITHDRAWN_DAYS=none
# Set to 1 only after the actual readiness evidence is approved.
MYCHEF_NEWSLETTER_OPERATIONS_READY=0
MYCHEF_NEWSLETTER_COLLECT=0
